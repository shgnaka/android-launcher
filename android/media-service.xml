<service android:name="dev.quiet.launcher.MediaAccessService"
    android:label="Quiet メディアアクセス"
    android:exported="true"
    android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
    <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
    <meta-data android:name="android.service.notification.default_filter_types" android:value="0" />
    <meta-data android:name="android.service.notification.disabled_filter_types" android:value="conversations|alerting|ongoing|silent" />
</service>
<activity android:name="dev.quiet.launcher.WidgetRequestActivity"
    android:exported="false"
    android:theme="@android:style/Theme.Translucent.NoTitleBar"
    android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode" />
